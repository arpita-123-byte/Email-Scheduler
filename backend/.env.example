# ---------- Server ----------
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Long random string used to sign session cookies and OAuth state
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Infra (matches docker-compose.yml) ----------
DATABASE_URL=postgresql://outbox:outbox@localhost:5432/outbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
ELASTICSEARCH_ENABLED=true

# ---------- Google OAuth (https://console.cloud.google.com/apis/credentials) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---------- Slack OAuth (https://api.slack.com/apps) ----------
# Slack only accepts HTTPS redirect URLs: expose the backend with ngrok and use that URL here.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-subdomain.ngrok-free.app/api/slack/callback

# ---------- Queue, concurrency and rate limits ----------
QUEUE_NAME=email-send
# Also run the worker inside the API process (set false when running `npm run dev:worker` separately)
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender, shared by all workers (2 seconds)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hourly caps, enforced with Redis counters keyed by window + scope
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# Window length. Keep 3600000 (1 hour); lower it (e.g. 60000) only to demo window roll-over quickly.
RATE_LIMIT_WINDOW_MS=3600000

# ethereal = real SMTP to Ethereal; json = no network (offline tests only)
MAIL_TRANSPORT=ethereal

# Optional basic auth for Bull Board at /admin/queues (open when empty)
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
